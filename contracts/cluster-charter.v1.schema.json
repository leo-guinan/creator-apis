{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo-guinan/creator-apis/contracts/cluster-charter.v1.schema.json",
  "title": "cluster-charter@1",
  "description": "A cluster is a collection of miners and factories that governs itself. Everything here is configurable by the cluster; the protocol invariants (sealed records, no self-graded quality, one cluster per delivery, no retroactive change, no negative payouts, standard outcome metrics) are not. Each version takes effect from a stated epoch and links to the previous version's hash.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "effectiveFrom",
    "members",
    "admission",
    "exit",
    "epochs",
    "quality",
    "rewardsCurve",
    "lifecycle",
    "sponsorship",
    "revenueMining",
    "amendments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cluster-charter@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "previousVersionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "members": {
      "type": "object",
      "required": [
        "miners",
        "factories"
      ],
      "additionalProperties": false,
      "properties": {
        "miners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^miner:[a-z0-9][a-z0-9-]{0,63}$"
              },
              "qiAddress": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "quaiAddress": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          }
        },
        "factories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "factoryId",
              "creatorId",
              "sponsors"
            ],
            "additionalProperties": false,
            "properties": {
              "factoryId": {
                "type": "string",
                "minLength": 1
              },
              "creatorId": {
                "type": "string",
                "minLength": 1
              },
              "sponsors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "open",
            "invite",
            "stake",
            "vote"
          ]
        },
        "minStakeQiBase": {
          "type": "integer",
          "minimum": 0,
          "description": "Qi base units (0.001 Qi)"
        },
        "approvalBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "exit": {
      "type": "object",
      "required": [
        "noticeEpochs"
      ],
      "additionalProperties": false,
      "properties": {
        "noticeEpochs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "epochs": {
      "type": "object",
      "required": [
        "ignition",
        "online",
        "production",
        "mature"
      ],
      "additionalProperties": false,
      "properties": {
        "ignition": {
          "type": "string",
          "pattern": "^P(\\d+D|\\d+W)$",
          "description": "ISO 8601 duration in days or weeks"
        },
        "online": {
          "type": "string",
          "pattern": "^P(\\d+D|\\d+W)$",
          "description": "ISO 8601 duration in days or weeks"
        },
        "production": {
          "type": "string",
          "pattern": "^P(\\d+D|\\d+W)$",
          "description": "ISO 8601 duration in days or weeks"
        },
        "mature": {
          "type": "string",
          "pattern": "^P(\\d+D|\\d+W)$",
          "description": "ISO 8601 duration in days or weeks"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "acceptedSources",
        "defaultQ0"
      ],
      "additionalProperties": false,
      "properties": {
        "acceptedSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "customer",
              "network_evaluator",
              "press_documented"
            ]
          },
          "uniqueItems": true
        },
        "defaultQ0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "rewardsCurve": {
      "type": "object",
      "required": [
        "beta",
        "floor",
        "cap",
        "minSamples"
      ],
      "additionalProperties": false,
      "properties": {
        "beta": {
          "type": "number",
          "minimum": 0
        },
        "floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cap": {
          "type": "number",
          "minimum": 1
        },
        "minSamples": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "firstLight",
        "steadyState",
        "lindy",
        "lineage",
        "bountySplit"
      ],
      "additionalProperties": false,
      "properties": {
        "firstLight": {
          "type": "object",
          "required": [
            "minAccepted",
            "minDocumentedRate",
            "bountyQiBase"
          ],
          "additionalProperties": false,
          "properties": {
            "minAccepted": {
              "type": "integer",
              "minimum": 1
            },
            "minDocumentedRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bountyQiBase": {
              "type": "integer",
              "minimum": 0,
              "description": "Qi base units (0.001 Qi)"
            }
          }
        },
        "steadyState": {
          "type": "object",
          "required": [
            "minStability",
            "consecutiveEpochs",
            "maxAttemptsPerKeeper",
            "bountyQiBase"
          ],
          "additionalProperties": false,
          "properties": {
            "minStability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "consecutiveEpochs": {
              "type": "integer",
              "minimum": 1
            },
            "maxAttemptsPerKeeper": {
              "type": "number",
              "minimum": 1
            },
            "bountyQiBase": {
              "type": "integer",
              "minimum": 0,
              "description": "Qi base units (0.001 Qi)"
            }
          }
        },
        "lindy": {
          "type": "object",
          "required": [
            "epochs",
            "bountyQiBase"
          ],
          "additionalProperties": false,
          "properties": {
            "epochs": {
              "type": "integer",
              "minimum": 1
            },
            "bountyQiBase": {
              "type": "integer",
              "minimum": 0,
              "description": "Qi base units (0.001 Qi)"
            }
          }
        },
        "lineage": {
          "type": "object",
          "required": [
            "bountyQiBase"
          ],
          "additionalProperties": false,
          "properties": {
            "bountyQiBase": {
              "type": "integer",
              "minimum": 0,
              "description": "Qi base units (0.001 Qi)"
            }
          }
        },
        "bountySplit": {
          "type": "object",
          "required": [
            "factoryBps",
            "sponsorBps",
            "contributorsBps",
            "burnBps"
          ],
          "additionalProperties": false,
          "properties": {
            "factoryBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "sponsorBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "contributorsBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "burnBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    },
    "sponsorship": {
      "type": "object",
      "required": [
        "returnRateBps",
        "paybackMultiple",
        "stages",
        "burnCurve",
        "demandSubsidy"
      ],
      "additionalProperties": false,
      "properties": {
        "returnRateBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "paybackMultiple": {
          "type": "number",
          "minimum": 1
        },
        "stages": {
          "type": "object",
          "required": [
            "beforePayback",
            "afterPayback",
            "mature"
          ],
          "additionalProperties": false,
          "properties": {
            "beforePayback": {
              "type": "object",
              "required": [
                "name",
                "minerBps",
                "factoryBps",
                "burnBps"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "minerBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "factoryBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "burnBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "afterPayback": {
              "type": "object",
              "required": [
                "name",
                "minerBps",
                "factoryBps",
                "burnBps"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "minerBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "factoryBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "burnBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "mature": {
              "type": "object",
              "required": [
                "name",
                "minerBps",
                "factoryBps",
                "burnBps"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "minerBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "factoryBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "burnBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            }
          }
        },
        "burnCurve": {
          "type": "object",
          "required": [
            "baseBps",
            "bpsPerDoubling",
            "maxBps"
          ],
          "additionalProperties": false,
          "properties": {
            "baseBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "bpsPerDoubling": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "demandSubsidy": {
          "type": "boolean"
        }
      }
    },
    "revenueMining": {
      "type": "object",
      "required": [
        "setAsideBps",
        "burnBps",
        "finderBps",
        "workshareWindowEpochs",
        "minTenureEpochs"
      ],
      "additionalProperties": false,
      "properties": {
        "setAsideBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "burnBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "finderBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "workshareWindowEpochs": {
          "type": "integer",
          "minimum": 1
        },
        "minTenureEpochs": {
          "type": "integer",
          "minimum": 0
        },
        "perFactoryCapBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "noWinDecayEpochs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "token": {
      "type": "object",
      "required": [
        "burnSchedule"
      ],
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "contract": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "burnDestination": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "burnSchedule": {
          "enum": [
            "per_epoch",
            "ritual"
          ]
        }
      }
    },
    "amendments": {
      "type": "object",
      "required": [
        "approvalBps",
        "effectiveAfterEpochs"
      ],
      "additionalProperties": false,
      "properties": {
        "approvalBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "effectiveAfterEpochs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
